---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { TOPICS, SITE } from '../../data/topics';
import { excerpt, formatDate, getPosts, readingTime, type Post } from '../../data/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, all: posts } }));
}

interface Props { post: Post; all: Post[] }
const { post, all } = Astro.props;
const { Content } = await render(post);
const topic = TOPICS[post.data.category];
const url = new URL(Astro.url.pathname, Astro.site).href;
const description = excerpt(post, 160);
const related = all.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3);
const more = related.length ? related : all.filter((p) => p.id !== post.id).slice(0, 3);
const enc = encodeURIComponent;
---
<Base
  title={post.data.title}
  description={description}
  type="article"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description,
    datePublished: post.data.date.toISOString(),
    author: { '@type': 'Person', name: SITE.name, url: Astro.site?.href },
    mainEntityOfPage: url,
    keywords: post.data.tags.join(', '),
  }}
>
  <section class="page-head" style={`--c:${topic.color}`}>
    <div class="glow g1"></div><div class="glow g2"></div>
    <div class="wrap narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/posts/">Posts</a> / <a href={`/topics/${post.data.category}/`}>{topic.label}</a>
      </nav>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <a class="pill" href={`/topics/${post.data.category}/`}>{topic.icon} {topic.label}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>· {readingTime(post)} min read</span>
        {post.data.linkedin && <span>· Also on LinkedIn</span>}
      </div>
    </div>
  </section>

  <article class="wrap narrow article" style={`--c:${topic.color}`}>
    {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>}
    <div class="prose">
      <Content />
    </div>

    {post.data.linkedin && (
      <div class="callout">
        <p>💬 Join the discussion on LinkedIn</p>
        <a class="btn btn-li" href={post.data.linkedin} target="_blank" rel="noopener">View on LinkedIn →</a>
      </div>
    )}

    <div class="share">
      <span>Share:</span>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener">LinkedIn</a>
      <a href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(post.data.title)}`} target="_blank" rel="noopener">X</a>
      <a href={`https://wa.me/?text=${enc(post.data.title + ' ' + url)}`} target="_blank" rel="noopener">WhatsApp</a>
      <button type="button" id="copy" data-url={url}>Copy link</button>
    </div>
  </article>

  {more.length > 0 && (
    <div class="wrap">
      <section class="block">
        <div class="sec-head"><div><p class="kicker">Keep reading</p><h2>{related.length ? `More on ${topic.label}` : 'More posts'}</h2></div></div>
        <div class="posts">{more.map((p) => <PostCard post={p} />)}</div>
      </section>
    </div>
  )}
</Base>

<script>
  const btn = document.getElementById('copy');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
      btn.textContent = 'Copied ✓';
    } catch {
      btn.textContent = 'Copy failed';
    }
    setTimeout(() => (btn.textContent = 'Copy link'), 2000);
  });
</script>
