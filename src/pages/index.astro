---
import Base from '../layouts/Base.astro';
import Hub from '../components/Hub.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import Socials from '../components/Socials.astro';
import { TOPICS, TOPIC_IDS, SITE } from '../data/topics';
import { getPosts } from '../data/posts';

const posts = await getPosts();
const latest = posts.slice(0, 6);
const countFor = (id: string) => posts.filter((p) => p.data.category === id).length;
const updated = posts[0]?.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }) ?? '';
const steps = ['Networking basics', 'Linux', 'Servers', 'Virtualization', 'Firewall rules', 'M365 security', 'Monitoring & backup', 'Automation'];
---
<Base jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: Astro.site?.href }}>
  <section class="hero">
    <div class="wrap hero-copy">
      <span class="eyebrow"><b>New</b> Practical IT notes &amp; real-world guides</span>
      <h1>Your practical guide to <span class="grad">IT&nbsp;infrastructure</span> that just works</h1>
      <p class="lead">
        Clear, tested notes by Basim Mohammed on networking, servers, security, Microsoft 365,
        Odoo and automation — no confusion, just what keeps systems running.
      </p>
      <div class="hero-actions">
        <a class="btn btn-brand" href="/posts/"><Icon name="book" /> Start reading</a>
        <a class="btn btn-ghost" href="/topics/">Browse topics <Icon name="arrow" /></a>
      </div>
    </div>

    <div class="wrap hub-wrap">
      <Hub />
    </div>

    <div class="wrap">
      <dl class="stats">
        <div><dt>Posts &amp; notes</dt><dd>{posts.length}</dd></div>
        <div><dt>Topic areas</dt><dd>{TOPIC_IDS.length}</dd></div>
        {updated && <div><dt>Last updated</dt><dd>{updated}</dd></div>}
        <div><dt>Follow along</dt><dd><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></dd></div>
      </dl>
    </div>
  </section>

  <div class="wrap">
    <section class="block reveal">
      <div class="sec-head">
        <div>
          <p class="kicker">Explore</p>
          <h2>Topics I write about</h2>
          <p>Notes for practical IT work: clear steps, real troubleshooting, security planning, infrastructure design, and easy revision.</p>
        </div>
        <a class="btn btn-outline" href="/topics/">All topics <Icon name="arrow" /></a>
      </div>
      <div class="topics">
        {TOPIC_IDS.map((id) => {
          const t = TOPICS[id];
          const n = countFor(id);
          return (
            <a class="topic" href={`/topics/${id}/`}>
              <span class="count">{n ? `${n} ${n === 1 ? 'post' : 'posts'}` : 'Soon'}</span>
              <div class="ico"><Icon name={id} /></div>
              <h3>{t.label}</h3>
              <p>{t.description}</p>
            </a>
          );
        })}
      </div>
    </section>

    <section class="block reveal">
      <div class="sec-head">
        <div>
          <p class="kicker">Fresh content</p>
          <h2>Latest posts</h2>
          <p>New notes and my latest LinkedIn posts, all in one place.</p>
        </div>
        <a class="btn btn-outline" href="/posts/">All posts <Icon name="arrow" /></a>
      </div>
      <div class="posts">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <section class="block reveal">
      <div class="path">
        <p class="kicker">Recommended</p>
        <div class="sec-head" style="margin-bottom:34px">
          <div>
            <h2>Technical learning path</h2>
            <p>Start with the foundations and build up. Each step builds on the previous one.</p>
          </div>
        </div>
        <ol class="steps">
          {steps.map((s) => <li class="step">{s}</li>)}
        </ol>
      </div>
    </section>

    <section class="cta reveal">
      <h2>Let's talk tech</h2>
      <p>For technical notes, IT guides, project discussions, or collaboration, reach out by email or connect on social media.</p>
      <a class="btn btn-white" href={`mailto:${SITE.email}`}><Icon name="mail" /> {SITE.email}</a>
      <Socials />
    </section>
  </div>
</Base>

<style>
  .hero { padding: 150px 0 40px; }
  .hero-copy { position: relative; z-index: 3; text-align: center; }
  .hero h1 { margin: 0 auto 20px; max-width: 1000px; font-size: clamp(2.2rem, 5vw, 3.9rem); line-height: 1.06; letter-spacing: -.05em; font-weight: 500; text-wrap: balance; }
  .lead { margin: 0 auto 32px; color: var(--muted); font-size: 1.14rem; max-width: 640px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .hub-wrap { position: relative; z-index: 2; margin-top: -150px; pointer-events: none; }
  .hub-wrap :global(.tile) { pointer-events: auto; }
  .stats {
    position: relative; z-index: 3; margin: 26px auto 0; max-width: 860px; padding: 18px 10px;
    display: grid; grid-template-columns: repeat(4, 1fr);
    background: color-mix(in srgb, var(--surface) 80%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow);
  }
  .stats div { text-align: center; padding: 0 10px; }
  .stats div + div { border-left: 1px solid var(--line); }
  .stats dt { font-size: .78rem; color: var(--muted); }
  .stats dd { margin: 2px 0 0; font-size: 1.35rem; font-weight: 600; letter-spacing: -.03em; }
  .stats dd a { color: var(--brand-ink); }
  @media (max-width: 820px) {
    .hero { padding-top: 118px; }
    .hub-wrap { margin-top: 36px; pointer-events: auto; }
    .stats { grid-template-columns: repeat(2, 1fr); row-gap: 16px; margin-top: 64px; }
    .stats div:nth-child(3) { border-left: 0; }
  }
</style>
