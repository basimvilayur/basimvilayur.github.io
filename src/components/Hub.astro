---
// Hero diagram: the BM chip in the middle, the eight topics as 3D tiles, joined by
// glass "circuit" lines with light pulses running from the chip out to each topic.
import Icon from './Icon.astro';
import { TOPICS, TOPIC_IDS } from '../data/topics';

const W = 1200, H = 560, CX = 600, CY = 330, CHIP = 84; // CHIP = half the chip width in viewBox units
// Left column top-to-bottom, mirrored on the right; outer tiles sit further out.
const ys = [70, 215, 360, 500];
const xs = [95, 235, 235, 95];
const tiles = TOPIC_IDS.map((id, i) => {
  const side = i < 4 ? -1 : 1;
  const k = i % 4;
  const x = side < 0 ? xs[k] : W - xs[k];
  return { id, x, y: ys[k], side, k };
});

const paths = tiles.map(({ x, y, side, k }) => {
  const sx = CX + side * CHIP;          // leave from the chip's side
  const sy = CY + (k - 1.5) * 22;       // fan the four exits down the chip edge
  const ex = x - side * 54;             // arrive at the tile's inner edge
  const mid = (sx + ex) / 2;
  return `M${sx} ${sy} L${sx + side * 30} ${sy} C${mid} ${sy} ${mid} ${y} ${ex - side * 30} ${y} L${ex} ${y}`;
});
const pct = (v: number, of: number) => `${(v / of) * 100}%`;
---
<div class="hub" style={`aspect-ratio:${W}/${H}`}>
  <svg class="wires" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="pulse" x1="0" x2="1">
        <stop offset="0" stop-color="#22b8ff" stop-opacity="0" />
        <stop offset=".5" stop-color="#3b82ff" />
        <stop offset="1" stop-color="#22b8ff" stop-opacity="0" />
      </linearGradient>
      <filter id="glow" x="-20%" y="-50%" width="140%" height="200%">
        <feGaussianBlur stdDeviation="4" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    {paths.map((d) => <path class="tube" d={d} />)}
    {paths.map((d) => <path class="core" d={d} />)}
    {paths.map((d, i) => (
      <path class="pulse" d={d} pathLength="1000" filter="url(#glow)" style={`animation-delay:${(i * 0.41) % 3.2}s`} />
    ))}
  </svg>

  <div class="chip" style={`left:${pct(CX, W)};top:${pct(CY, H)}`}>
    <div class="chip-base"></div>
    <div class="chip-top"><span class="mark">BM</span></div>
    <div class="chip-pins"><i></i><i></i><i></i></div>
  </div>

  {tiles.map(({ id, x, y }, i) => (
    <a class="tile" href={`/topics/${id}/`} style={`left:${pct(x, W)};top:${pct(y, H)};--d:${i * -0.7}s`} aria-label={TOPICS[id].label}>
      <span class="tile-base"></span>
      <span class="tile-top"><Icon name={id} size={30} /></span>
      <span class="tile-label">{TOPICS[id].short}</span>
    </a>
  ))}
</div>

<style>
  .hub { position: relative; width: 100%; max-width: 1200px; margin: 0 auto; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .tube { fill: none; stroke: var(--wire-edge); stroke-width: 13; stroke-linecap: round; }
  .core { fill: none; stroke: var(--wire-core); stroke-width: 8; stroke-linecap: round; }
  .pulse {
    fill: none; stroke: url(#pulse); stroke-width: 5; stroke-linecap: round;
    stroke-dasharray: 90 910; stroke-dashoffset: 1000;
    animation: flow 3.2s cubic-bezier(.45, 0, .55, 1) infinite;
  }
  @keyframes flow { to { stroke-dashoffset: 0; } }

  /* Central chip */
  .chip { position: absolute; width: 14%; aspect-ratio: 1; transform: translate(-50%, -50%); z-index: 2; }
  .chip::before {
    content: ""; position: absolute; inset: -30% -40% -60%; z-index: -1;
    background: radial-gradient(closest-side, rgba(37, 99, 255, .42), transparent 70%);
    filter: blur(10px); animation: breathe 3.2s ease-in-out infinite;
  }
  @keyframes breathe { 50% { opacity: .55; transform: scale(.94); } }
  .chip-base {
    position: absolute; inset: 8% 0 -10%; border-radius: 22%;
    background: linear-gradient(180deg, #2f6bff, #0b3bd6 60%, #06208a);
    box-shadow: 0 0 0 2px rgba(120, 170, 255, .6) inset, 0 24px 44px rgba(11, 59, 214, .45), 0 0 40px rgba(34, 184, 255, .45);
  }
  .chip-top {
    position: absolute; inset: 0 6% 12%; border-radius: 20%;
    background: linear-gradient(160deg, var(--tile-face-1), var(--tile-face-2));
    box-shadow: 0 1px 0 rgba(255, 255, 255, .9) inset, 0 6px 14px rgba(11, 59, 214, .25);
    display: grid; place-items: center;
    background-image: radial-gradient(var(--tile-dots) 1px, transparent 1.3px), linear-gradient(160deg, var(--tile-face-1), var(--tile-face-2));
    background-size: 9px 9px, auto;
  }
  .mark {
    font-weight: 800; font-size: clamp(1.4rem, 3.4vw, 2.7rem); letter-spacing: -.06em;
    background: linear-gradient(135deg, #1463ff, #22b8ff); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .chip-pins { position: absolute; left: 50%; bottom: -14%; transform: translateX(-50%); display: flex; gap: 10%; width: 60%; justify-content: center; }
  .chip-pins i { width: 18%; aspect-ratio: 1 / 1.2; border-radius: 40%; background: linear-gradient(#5aa2ff, #1463ff); box-shadow: 0 0 12px #22b8ff; display: block; }

  /* Topic tiles */
  .tile {
    position: absolute; width: 8.2%; aspect-ratio: 1; transform: translate(-50%, -50%); z-index: 2;
    animation: bob 6s ease-in-out var(--d) infinite;
  }
  @keyframes bob { 50% { transform: translate(-50%, calc(-50% - 6px)); } }
  .tile-base {
    position: absolute; inset: 14% 0 -12%; border-radius: 22%;
    background: linear-gradient(180deg, var(--tile-side-1), var(--tile-side-2));
    box-shadow: 0 0 0 1.5px var(--tile-rim) inset, 0 18px 30px var(--tile-shadow), 0 6px 18px rgba(37, 99, 255, .22);
    transition: box-shadow .3s ease;
  }
  .tile-top {
    position: absolute; inset: 0 0 12%; border-radius: 22%; display: grid; place-items: center; color: var(--brand);
    background-image: radial-gradient(var(--tile-dots) 1px, transparent 1.3px), linear-gradient(160deg, var(--tile-face-1), var(--tile-face-2));
    background-size: 8px 8px, auto;
    box-shadow: 0 1px 0 rgba(255, 255, 255, .85) inset, 0 4px 10px rgba(15, 23, 42, .08);
    transition: transform .3s ease, color .3s ease;
  }
  .tile-top :global(svg) { width: 42%; height: 42%; }
  .tile-label {
    position: absolute; left: 50%; top: calc(100% + 18px); transform: translateX(-50%);
    font-size: .76rem; font-weight: 600; color: var(--muted); white-space: nowrap; transition: color .3s ease;
  }
  .tile:hover .tile-top, .tile:focus-visible .tile-top { transform: translateY(-5px); color: #fff; background-image: linear-gradient(160deg, #3b82ff, #1463ff); }
  .tile:hover .tile-base, .tile:focus-visible .tile-base { box-shadow: 0 0 0 1.5px #5aa2ff inset, 0 18px 30px var(--tile-shadow), 0 0 34px rgba(34, 184, 255, .7); }
  .tile:hover .tile-label { color: var(--brand); }

  @media (max-width: 820px) {
    .hub { aspect-ratio: auto !important; display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px 14px; padding-top: 150px; }
    .wires { display: none; }
    .chip { left: 50% !important; top: 0 !important; width: 116px; transform: translateX(-50%); }
    .tile { position: relative; left: auto !important; top: auto !important; width: 100%; max-width: 76px; justify-self: center; transform: none; animation: none; }
    .tile-label { top: calc(100% + 12px); font-size: .7rem; }
  }
  @media (prefers-reduced-motion: reduce) { .pulse { stroke-dasharray: none; stroke-dashoffset: 0; opacity: .35; } }
</style>
